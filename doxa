#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   # Keep in lock-step with [project.dependencies] in pyproject.toml. This
#   # manifest resolves independently and has no lockfile, so a drift here
#   # ships a launcher that runs different versions from the package — which
#   # is exactly what happened before v3.3.0.
#   "click>=8.3.3",
#   # Upper bound is load-bearing: openai 3.x switches the default transport to
#   # httpx2 and stops depending on httpx. Unbounded, this manifest resolved
#   # openai 3.10.0 while the package is locked to 2.37.0. Lifted by P43.
#   "openai>=2.36.0,<3",
#   "httpx>=0.27.0",
#   "rich>=13.7",
#   "platformdirs>=3.0",
#   "aiofiles>=25.1.0",
#   "tenacity>=9.1.4",
#   "python-dateutil>=2.8",
#   "prompt-toolkit>=3.0",
#   "tomlkit>=0.13",
#   "pydantic>=2.12.5,<3",
#   # Imported lazily inside the deep-research spinner (progress.py), so its
#   # absence only surfaces when a research run starts in a terminal.
#   "thothspinner>=1.2.6",
#   "google-genai>=2.0.0"
# ]
# ///
"""Development entry-point wrapper for doxa-research.

This script is used for local development and backward compatibility.
When installed via PyPI, the `doxa-research` command is provided by the package
entry point defined in pyproject.toml.
"""
import sys
from pathlib import Path

# Add src/ to sys.path so the local package is importable without installation
sys.path.insert(0, str(Path(__file__).parent / "src"))

from doxa_research.__main__ import main  # noqa: E402

main()
