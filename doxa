#!/usr/bin/env bash
# Development entry-point wrapper for doxa-research.
#
# Thin shim over the package's own console script. It exists only so the
# repo-relative path `./doxa` keeps working for `doxa_test`, the justfile smoke
# targets, and CONTRIBUTING; it adds no behaviour of its own.
#
# Deliberately NOT a PEP 723 script. That form carried a second, hand-maintained
# dependency manifest with no lockfile, which drifted from pyproject.toml and
# silently resolved a different major version of the OpenAI SDK than the package
# — while CI validated the integration suite through exactly that drifted
# environment. Resolving through uv.lock instead means one dependency set.
#
# When installed from PyPI, `doxa` and `doxa-research` are provided directly by
# the [project.scripts] entry points and this file is not involved.
exec uv run --quiet doxa "$@"
